# ============================================================
#  YAPPER COMMUNITY BOT  -  copy this file to ".env" and fill it
#  Get the token: Yapin' -> Settings -> Developer -> your bot
#  Channel / role IDs: right click -> copy ID (or GET /channels, /servers/{id}/roles)
# ============================================================

# ---------- Required ----------
BOT_TOKEN=yb_put_your_bot_token_here

# Only act in this server (leave empty to work in every server the bot is in)
SERVER_ID=

# Prefix for text commands as a fallback (/rank also works from the / menu)
COMMAND_PREFIX=!

# ---------- Local database ----------
DB_PATH=./data/bot.db

# ---------- Welcome messages ----------
WELCOME_ENABLED=true
WELCOME_CHANNEL_ID=
# Placeholders: {user} (mention) {username} {server} {count}
WELCOME_MESSAGE=Welcome {user} to **{server}**! You are member #{count}. Read the rules and have fun!
WELCOME_TITLE=Welcome!
WELCOME_COLOR=#5865f2
# true = pretty embed card, false = plain text message
WELCOME_EMBED=true
# Also send the new member a DM (true/false)
WELCOME_DM=false
# Goodbye message when someone leaves (leave channel empty to disable)
GOODBYE_CHANNEL_ID=
GOODBYE_MESSAGE={username} left the server. Now {count} members.

# ---------- Verification ----------
VERIFY_ENABLED=true
# Channel where the "Verify" panel is posted (the bot posts it by itself)
VERIFY_CHANNEL_ID=
# Role given after verification (create it first; keep it BELOW the bot's role)
VERIFIED_ROLE_ID=
# button = one click, captcha = pick the right emoji (stops simple bots)
VERIFY_MODE=captcha
VERIFY_TITLE=Verification
VERIFY_MESSAGE=Press the button below to verify and unlock the server.
# true = embed card, false = plain text message above the button
VERIFY_EMBED=true
# Optional: remove this role after verification (e.g. an "Unverified" role)
UNVERIFIED_ROLE_ID=
# Optional: log who verified
VERIFY_LOG_CHANNEL_ID=

# ---------- Tickets ----------
TICKETS_ENABLED=true
# Channel where the "Open ticket" panel is posted
TICKET_PANEL_CHANNEL_ID=
# Category the ticket channels are created in (optional but recommended)
TICKET_CATEGORY_ID=
# Staff role that can see and close every ticket
TICKET_STAFF_ROLE_ID=
# Where closed tickets are logged with a transcript (optional)
TICKET_LOG_CHANNEL_ID=
MAX_TICKETS_PER_USER=1
# private = only the opener + staff can see it (the bot makes a small role per ticket)
# open    = anyone who can see the category can see it
TICKET_MODE=private
TICKET_TITLE=Support
TICKET_MESSAGE=Need help? Press the button and a private channel will be created for you.

# ---------- Leveling ----------
LEVELING_ENABLED=true
# Where level-up messages go (empty = same channel as the message)
LEVEL_UP_CHANNEL_ID=
XP_MIN=15
XP_MAX=25
# Seconds between two XP gains for the same person
XP_COOLDOWN_SECONDS=60
# Role rewards: level:roleId, comma separated. Example: 5:ROLE_ID,10:ROLE_ID
LEVEL_ROLES=
# Channels that give no XP (comma separated IDs)
XP_IGNORED_CHANNELS=

# ---------- Daily reward (/daily) ----------
DAILY_ENABLED=true
DAILY_XP_MIN=100
DAILY_XP_MAX=200
# Extra XP for every day in a row (streak), growing up to DAILY_STREAK_MAX_DAYS
DAILY_STREAK_BONUS=25
DAILY_STREAK_MAX_DAYS=7
DAILY_COOLDOWN_HOURS=24

# ---------- Moderation (/kick /timeout /unmute) ----------
MODERATION_ENABLED=true
# Roles allowed to use the moderation commands, comma separated (the server owner always can)
MOD_ROLE_IDS=
# true = anyone whose role has Kick Members (/kick), Timeout Members (/timeout /unmute)
# or Manage Server / Administrator (all) can use the commands too
MOD_USE_ROLE_PERMISSIONS=true
# The owner can also add roles from chat: /modrole add @role
# Where moderation actions are logged (optional)
MOD_LOG_CHANNEL_ID=
DEFAULT_TIMEOUT_MINUTES=10

# ---------- Connection ----------
# gateway (WebSocket, fast) or poll (long poll, works everywhere)
CONNECTION_MODE=gateway
# Set to true to see every event in the console
DEBUG=false
